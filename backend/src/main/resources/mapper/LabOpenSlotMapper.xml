<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nlt.mapper.LabOpenSlotMapper">
    <select id="selectList" resultType="com.nlt.domain.entity.LabOpenSlotEntity">
        select *
        from lab_open_slot
        where 1 = 1
        <if test="labId != null">
            and lab_id = #{labId}
        </if>
        <if test="weekday != null">
            and weekday = #{weekday}
        </if>
        order by weekday asc, period_id asc, id asc
    </select>

    <select id="selectActiveByLabAndWeekdaysAndPeriods" resultType="com.nlt.domain.entity.LabOpenSlotEntity">
        select *
        from lab_open_slot
        where lab_id = #{labId}
            and status = 1
            <if test="weekdays != null and weekdays.size() > 0">
                and weekday in
                <foreach collection="weekdays" item="w" open="(" separator="," close=")">
                    #{w}
                </foreach>
            </if>
            <if test="periodIds != null and periodIds.size() > 0">
                and period_id in
                <foreach collection="periodIds" item="p" open="(" separator="," close=")">
                    #{p}
                </foreach>
            </if>
    </select>

    <select id="selectActiveByLabIdsAndWeekdayAndPeriods" resultType="com.nlt.domain.entity.LabOpenSlotEntity">
        select *
        from lab_open_slot
        where status = 1
            and weekday = #{weekday}
            and lab_id in
            <foreach collection="labIds" item="lid" open="(" separator="," close=")">
                #{lid}
            </foreach>
            <if test="periodIds != null and periodIds.size() > 0">
                and period_id in
                <foreach collection="periodIds" item="pid" open="(" separator="," close=")">
                    #{pid}
                </foreach>
            </if>
    </select>
</mapper>
